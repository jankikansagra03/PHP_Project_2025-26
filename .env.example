# ══════════════════════════════════════════════════════════════
#  .env.example  —  Template for JK Store Environment Config
#  Copy this file to .env and replace placeholder values.
#  This file IS safe to commit to Git.
# ══════════════════════════════════════════════════════════════

# ── App ────────────────────────────────────────────────────────
APP_NAME="JK Store"
APP_ENV=local                        # local | production
APP_URL=http://localhost/PHP/PHP_Project_2025-26
APP_DEBUG=true                       # true | false  (disable in production)

# ── Database ───────────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=php_project_25_26
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ── SMTP / PHPMailer ───────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_ENCRYPTION=ssl                  # ssl | tls
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="JK Store"

# ── Google OAuth ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Cashfree ───────────────────────────────────────────────────
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key
CASHFREE_ENV=sandbox                 # sandbox | production

# ── Razorpay ───────────────────────────────────────────────────
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# ── PayPal ─────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_ENV=sandbox                   # sandbox | live
